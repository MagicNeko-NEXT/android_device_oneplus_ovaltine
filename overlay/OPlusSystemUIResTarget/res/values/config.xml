<resources>

    <!-- Whether to enable framework dimming for UDFPS -->
    <bool name="config_udfpsFrameworkDimming">true</bool>

    <!--
        UDFPS dim layer strength table: overrides the generic values in SystemUI lineage_config.xml.

        Why the device tree overrides it:
        - This panel's DTSI is oplus,ofp-fp-type = <0x08>, with no BIT(4) local HBM.
          On a fingerprint press the panel can only enter HBM full-screen, and the look of lighting only the fingerprint area
          relies entirely on SystemUI's "Dim Layer for UDFPS".
        - The generic LineageOS table dims very little at mid to high brightness: at brightness 2383 alpha measures only
          0.1508, barely offsetting full-screen HBM gain → the whole screen looks brightened.
        - Upstream lineage-ovaltine-dev has a commit "Drop udfps dimming brightness
          alpha array", meaning this device has no tuning and falls back to the generic values.

        This table holds values hot-tested on device 734ce825 on 2026-10-11
        (test artifact: RRO com.xi.udfpsdim, sha256 70def664a1fc8fe…).

        Format: <brightness, alpha>. Brightness must be strictly ascending, and the last entry must equal the panel maximum
        brightness 4095: UdfpsHelper uses brightnessAlphaMap.keys.max() as
        maxPanelBrightness for scaling, so changing the last entry rescales key lookup across the whole table.
    -->
    <string-array name="config_udfpsDimmingBrightnessAlphaArray" translatable="false">
        <item>3,250</item>
        <item>50,250</item>
        <item>150,248</item>
        <item>300,246</item>
        <item>500,244</item>
        <item>800,242</item>
        <item>1023,240</item>
        <item>1300,238</item>
        <item>1600,236</item>
        <item>1817,234</item>
        <item>2047,232</item>
        <item>2500,230</item>
        <item>3000,228</item>
        <item>3500,226</item>
        <item>4095,224</item>
    </string-array>
</resources>
